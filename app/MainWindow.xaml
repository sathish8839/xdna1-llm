<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Xdna1Chat.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="xdna1 chat">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar (the content extends into it) with the engine status: dot, model and device, last speed. -->
        <Grid x:Name="TitleBar" Padding="20,10,150,8" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="StatusDot" Width="10" Height="10" VerticalAlignment="Center"
                     Fill="{ThemeResource TextFillColorDisabledBrush}" />
            <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Text="Starting…" />
            <Button x:Name="ModelButton" Grid.Column="2" Content="Model…" Click="OnChooseModel"
                    ToolTipService.ToolTip="Choose the GGUF model file" />
            <Button Grid.Column="3" Content="New chat" Click="OnNewChat" />
        </Grid>

        <InfoBar x:Name="Banner" Grid.Row="1" Margin="20,0,20,8" IsOpen="False" Severity="Error" />

        <ScrollViewer x:Name="Scroller" Grid.Row="2" HorizontalScrollMode="Disabled">
            <StackPanel x:Name="Messages" MaxWidth="860" Padding="24,8,24,24" Spacing="10" />
        </ScrollViewer>
        <TextBlock x:Name="EmptyHint" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                   MaxWidth="420" TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   Text="LFM3 runs on this PC's NPU. Nothing leaves the machine unless you turn on web search." />

        <!-- Composer -->
        <Grid Grid.Row="3" MaxWidth="860" Padding="24,4,24,20" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox x:Name="Input" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="180"
                     PlaceholderText="Message (Enter to send, Shift+Enter for a new line)"
                     PreviewKeyDown="OnInputKeyDown" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <ToggleButton x:Name="ThinkToggle" Content="Thinking" Click="OnToggle"
                              ToolTipService.ToolTip="Let the model reason before it answers (slower)" />
                <ToggleButton x:Name="SearchToggle" Content="Web search" Click="OnToggle"
                              ToolTipService.ToolTip="Let the model search the web with DuckDuckGo" />
            </StackPanel>
            <Button x:Name="SendButton" Grid.Row="1" HorizontalAlignment="Right" MinWidth="88"
                    Style="{StaticResource AccentButtonStyle}" Content="Send" IsEnabled="False" Click="OnSend" />
        </Grid>
    </Grid>
</Window>
